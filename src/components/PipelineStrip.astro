---
// Source → orchestration → warehouse → transformation → dashboard, one step per stage.
interface Props {
  steps: { stage: string; tool: string }[];
}

const { steps } = Astro.props;
---

<ol class="pipeline" aria-label="Pipeline">
  {
    steps.map((s) => (
      <li>
        <span class="stage">{s.stage}</span>
        <span class="tool">{s.tool}</span>
      </li>
    ))
  }
</ol>

<style>
  .pipeline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) 0;
    list-style: none;
    margin: 0;
    padding: var(--space-4) 0;
    border-block: 1px solid var(--border);
    font-family: var(--font-mono);
  }

  li {
    display: grid;
    gap: 2px;
  }

  /* Arrow between steps; decorative, so it lives in CSS rather than the text */
  li + li::before {
    content: "→";
    grid-row: 1 / 3;
    align-self: end;
    padding-inline: var(--space-4);
    color: var(--decor-muted);
  }

  li + li {
    grid-template-columns: auto 1fr;
  }

  li + li > span {
    grid-column: 2;
  }

  .stage {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .tool {
    font-size: var(--step--1);
    color: var(--text);
  }
</style>
