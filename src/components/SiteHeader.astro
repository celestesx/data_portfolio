---
import { site, nav } from "../site.config";

// Mark the current section. "/" only matches exactly; "/about" also matches "/about/".
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? path === "/" || path.startsWith("/projects") : path.startsWith(href);
---

<header class="wrap site-header">
  <a class="logo" href="/">{site.handle}<span aria-hidden="true">_</span></a>
  <nav aria-label="Main">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .logo {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
  }

  .logo span {
    color: var(--accent);
  }

  ul {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  ul a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  ul a:hover,
  ul a[aria-current="page"] {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
</style>
