---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/Tag.astro";
import { site } from "../site.config";

const stack = ["python", "sql", "dbt", "duckdb", "snowflake", "dagster", "github actions", "tableau", "power bi"];
---

<BaseLayout>
  <div class="wrap">
    <section class="hero">
      <p class="label"><span class="slash">//</span> {site.role}</p>
      <h1>Reliable pipelines underneath. <em>Clear stories</em> on top.</h1>
      <p class="intro">
        I build the ingestion, models and tests that make numbers trustworthy, then design the charts that make them
        readable. Every project here shows all three layers.
      </p>
      <ul class="tags" aria-label="Core stack">
        {stack.map((s) => <Tag label={s} />)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    padding-block: clamp(2.25rem, 7vw, 5.5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .intro {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 54ch;
  }
</style>
