---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/Tag.astro";
import { site } from "../site.config";

const stack = [
  "python",
  "sql",
  "dbt",
  "duckdb",
  "snowflake",
  "dagster",
  "docker",
  "terraform",
  "aws",
  "github actions",
  "tableau",
  "power bi",
];
---

<BaseLayout>
  <div class="wrap">
    <section class="hero">
      <p class="label"><span class="slash">//</span> {site.role}</p>
      <h1>Dropped into messy data. <em>Shipped something they use.</em></h1>
      <p class="intro">
        I embed with teams, work out the real problem behind the request, and ship working pipelines in weeks, not
        quarters. Then I hand them over properly: tested, documented, and owned by the people who use them.
      </p>
      <ul class="tags" aria-label="Core stack">
        {stack.map((s) => <Tag label={s} />)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    padding-block: clamp(2.25rem, 7vw, 5.5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .intro {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 54ch;
  }
</style>
